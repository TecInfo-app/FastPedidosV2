rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil de usuário
    match /users/{userId} {
      allow read, write: if true;

      // Lojas
      match /stores/{storeId} {
        allow read, write: if true;
      }

      // Taxas de entrega
      match /rates/{rateId} {
        allow read, write: if true;
      }

      // Motoboys / Entregadores
      match /motoboys/{motoboyId} {
        allow read, write: if true;
      }

      // Pedidos
      match /orders/{orderId} {
        allow read, write: if true;
      }

      // Relatórios diários
      match /dailyReports/{reportId} {
        allow read, write: if true;
      }
    }

    // Regra global de segurança para evitar bloqueios em qualquer outra subcoleção
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
