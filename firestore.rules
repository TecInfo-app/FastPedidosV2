rules_version = '2';
service cloudfirestore {
  match /databases/{database}/documents {
    // Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Match users collection
    match /users/{userId} {
      // The store owner (authenticated on any device) can do everything under their account
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /stores/{storeId} {
        // Shared devices / motoboy view need to read stores
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /rates/{rateId} {
        // Shared devices / motoboy view need to read delivery rates
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /motoboys/{motoboyId} {
        // Anyone can read and update motoboys (needed for courier portal status change across multiple devices)
        allow read, write: if true;
      }

      match /orders/{orderId} {
        // Anyone can read, create, and update orders (needed for auto dispatching, shared portal status changes, and multi-device sync)
        allow read, write: if true;
      }

      match /dailyReports/{reportId} {
        // Daily financial reports are private to the merchant owner
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
